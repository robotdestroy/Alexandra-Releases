<Window x:Class="Alexandra.App.UpdatesWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="Alexandra · Updates" Width="510" Height="370" MinWidth="430" MinHeight="300"
    Icon="Assets/alexandra-icon.ico" WindowStartupLocation="CenterOwner"
    Background="{StaticResource WindowBrush}" Foreground="{StaticResource TextPrimaryBrush}" FontFamily="{StaticResource BodyFontFamily}" FontSize="17">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
    <StackPanel Margin="24">
        <TextBlock Text="UPDATES" FontFamily="{StaticResource AlexandraFontFamily}" FontSize="28" Foreground="{StaticResource AccentBrush}"/>
        <TextBlock x:Name="VersionText" Margin="0,8,0,18"/>
        <CheckBox x:Name="AutomaticBox" Content="Automatically download updates" Click="AutomaticClick"/>
        <TextBlock Text="Checks after startup and every six hours. Downloaded updates install on the next launch, never during a conversation. Turning this off stops future automatic checks; an already downloaded update still installs next launch."
                   FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" TextWrapping="Wrap" Margin="24,6,0,18"/>
        <TextBlock x:Name="StatusText" TextWrapping="Wrap"/>
        <ProgressBar x:Name="Progress" Height="5" Maximum="100" Margin="0,12,0,8" Visibility="Collapsed"/>
        <WrapPanel Margin="0,14,0,0">
            <Button x:Name="CheckButton" Content="Check now" Click="CheckClick"/>
            <Button x:Name="RestartButton" Content="Restart to update" Click="RestartClick" Margin="10,4,0,4" Visibility="Collapsed"/>
        </WrapPanel>
    </StackPanel>
    </ScrollViewer>
</Window>
