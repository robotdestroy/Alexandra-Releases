<Window x:Class="Alexandra.App.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="Alexandra" Width="460" Height="250" MinWidth="230" MinHeight="125" MaxWidth="920" MaxHeight="500"
    WindowStyle="None" AllowsTransparency="True" Background="Transparent" Icon="Assets/alexandra-icon.ico"
    Foreground="{StaticResource TextPrimaryBrush}" FontFamily="{StaticResource BodyFontFamily}"
    WindowStartupLocation="CenterScreen" ResizeMode="CanResizeWithGrip" ContextMenuOpening="MoreMenuOpening">
    <Window.ContextMenu>
        <ContextMenu x:Name="MoreMenu" Width="280" Opened="MoreMenuOpened">
            <MenuItem Header="SETUP" Click="SetupClick"/>
            <MenuItem x:Name="UpdatesMenu" Header="Updates…" Click="UpdatesClick"/>
            <MenuItem x:Name="MinimalMenu" Header="Minimal mode" IsCheckable="True" Click="MinimalClick"/>
            <MenuItem x:Name="TopmostMenu" Header="Keep on top" IsCheckable="True" Click="TopmostClick"/>
            <MenuItem x:Name="ThinkingSoundMenu" Header="Thinking sound" IsCheckable="True" Click="ThinkingSoundClick"/>
            <Separator Style="{StaticResource {x:Type Separator}}"/>
            <MenuItem x:Name="SmallerMenu" Header="Smaller" Click="SmallerClick"/>
            <MenuItem x:Name="LargerMenu" Header="Larger" Click="LargerClick"/>
            <MenuItem x:Name="ResetSizeMenu" Header="Reset size (100%)" Click="ResetSizeClick"/>
            <Separator Style="{StaticResource {x:Type Separator}}"/>
            <MenuItem Header="Sources from last answer…" Click="SourcesClick"/>
            <MenuItem Header="Open screenshots folder…" Click="ScreenshotsClick"/>
            <MenuItem Header="View debug logs…" Click="LogsClick"/>
            <MenuItem Header="Stop speaking" Click="StopClick"/>
            <MenuItem Header="Clear conversation" Click="ClearClick"/>
            <Separator Style="{StaticResource {x:Type Separator}}"/>
            <MenuItem Header="Exit" Click="ExitClick"/>
        </ContextMenu>
    </Window.ContextMenu>
    <Viewbox x:Name="InterfaceScale" Stretch="Uniform" StretchDirection="Both">
    <Grid x:Name="RootSurface" Width="460" Height="250" Background="{StaticResource WindowBrush}" PreviewMouseLeftButtonDown="MinimalMouseDown">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <Border x:Name="HeaderArea" Height="60" BorderBrush="{StaticResource AccentBrush}" BorderThickness="0,0,0,2" Padding="18,0,12,0">
            <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <Border Background="Transparent" MouseLeftButtonDown="DragTitle" Cursor="SizeAll" ToolTip="Drag to move Alexandra">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="ALEXANDRA" FontFamily="{StaticResource AlexandraFontFamily}" FontSize="28"
                                   Foreground="{StaticResource AccentBrush}" VerticalAlignment="Center"/>
                        <TextBlock x:Name="VersionLabel" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}"
                                   Margin="10,1,0,0" VerticalAlignment="Center"/>
                    </StackPanel>
                </Border>
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Style="{StaticResource IconButton}" Click="MenuClick" ToolTip="Setup and appearance"
                            AutomationProperties.Name="Open Alexandra menu">
                        <Path Data="M 1,3 L 15,3 M 1,8 L 15,8 M 1,13 L 15,13"
                              Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.5"/>
                    </Button>
                    <Button Style="{StaticResource IconButton}" Click="MinimizeClick" ToolTip="Minimize" AutomationProperties.Name="Minimize Alexandra">
                        <Path Data="M 2,8 L 14,8" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.5"/>
                    </Button>
                    <Button Style="{StaticResource IconButton}" Click="ExitClick" ToolTip="Close" AutomationProperties.Name="Close Alexandra">
                        <Path Data="M 3,3 L 13,13 M 13,3 L 3,13" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.5"/>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>
        <Grid x:Name="WaveformArea" Grid.Row="1" Margin="18,6" Background="Transparent" PreviewMouseLeftButtonDown="VoiceMouseDown"
              PreviewMouseLeftButtonUp="VoiceMouseUp" LostMouseCapture="VoiceMouseLost"
              ToolTip="Hold here to talk, or use your keyboard / HOTAS button">
            <StackPanel x:Name="Waveform" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center"/>
        </Grid>
        <Border x:Name="VoiceNotice" Grid.Row="1" VerticalAlignment="Bottom" Margin="24,0,24,18"
                Background="#E6000000" Padding="10,7" Visibility="Collapsed" IsHitTestVisible="False">
            <TextBlock x:Name="VoiceNoticeText" FontSize="12" Foreground="{StaticResource TextPrimaryBrush}"
                       TextAlignment="Center" TextWrapping="Wrap" MaxHeight="55"/>
        </Border>
        <StackPanel x:Name="StatusArea" Grid.Row="2" Margin="18,0,18,20">
            <TextBlock x:Name="StatusText" Text="Conversation ready" FontSize="17" TextAlignment="Center"
                       TextWrapping="Wrap" MaxHeight="64" Foreground="{StaticResource TextPrimaryBrush}"/>
            <TextBlock x:Name="HintText" Margin="0,8,0,0" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}"
                       TextAlignment="Center" TextWrapping="Wrap" Text="Hold F12 to talk · AI-generated voice"/>
        </StackPanel>
    </Grid>
    </Viewbox>
</Window>

