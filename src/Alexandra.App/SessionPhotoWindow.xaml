<Window x:Class="Alexandra.App.SessionPhotoWindow"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 Title="Alexandra · Session photo" Width="1120" Height="760" MinWidth="680" MinHeight="440"
 WindowStartupLocation="CenterOwner" Background="{DynamicResource WindowBrush}" Foreground="{DynamicResource TextPrimaryBrush}"
 PreviewKeyDown="PhotoKeyDown">
 <Grid Margin="16">
  <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <StackPanel Margin="0,0,0,12">
   <TextBlock x:Name="Caption" FontSize="21" TextTrimming="CharacterEllipsis"/>
   <TextBlock x:Name="PhotoFile" FontSize="12" TextTrimming="CharacterEllipsis"/>
  </StackPanel>
  <Grid Grid.Row="1" Background="{DynamicResource PanelBrush}">
   <ScrollViewer x:Name="PhotoScroll" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto"
    HorizontalContentAlignment="Center" VerticalContentAlignment="Center" SizeChanged="PhotoSizeChanged">
    <Image x:Name="PhotoImage" Stretch="Uniform" RenderOptions.BitmapScalingMode="HighQuality" AutomationProperties.Name="Session photo"/>
   </ScrollViewer>
   <TextBlock x:Name="PhotoStatus" HorizontalAlignment="Center" VerticalAlignment="Center" TextWrapping="Wrap" Margin="30"/>
  </Grid>
  <TextBlock x:Name="CopyNotice" Grid.Row="2" FontSize="12" TextWrapping="Wrap" Margin="0,8,0,0" Visibility="Collapsed"
   AutomationProperties.Name="Photo copy status" AutomationProperties.LiveSetting="Polite"/>
  <DockPanel Grid.Row="3" Margin="0,12,0,0" LastChildFill="True">
   <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
    <Button x:Name="CopyPhoto" Content="Copy" Click="CopyPhotoClick" ToolTip="Copy photo to clipboard (Ctrl+C)"
     AutomationProperties.Name="Copy photo to clipboard" Margin="0,0,12,0" IsEnabled="False"/>
    <Button x:Name="ZoomOut" Content="−" Click="ZoomOutClick" ToolTip="Zoom out" AutomationProperties.Name="Zoom out" Margin="0,0,8,0"/>
    <Button x:Name="Fit" Content="Fit" Click="FitClick" Margin="0,0,8,0"/>
    <Button x:Name="ZoomIn" Content="+" Click="ZoomInClick" ToolTip="Zoom in" AutomationProperties.Name="Zoom in" Margin="0,0,8,0"/>
    <Button Content="Close" Click="CloseClick"/>
   </StackPanel>
   <StackPanel Orientation="Horizontal">
    <Button x:Name="Previous" Content="Previous" Click="PreviousClick" Margin="0,0,8,0"/>
    <TextBlock x:Name="PhotoCount" FontSize="12" VerticalAlignment="Center" Margin="0,0,8,0"/>
    <Button x:Name="Next" Content="Next" Click="NextClick"/>
   </StackPanel>
  </DockPanel>
 </Grid>
</Window>
